export default async function handler(req, res) {
  // Hedef yayın adresi
  const targetUrl = "https://trend48.st/live-tv?ch=beinsports1-tr";

  try {
    // Hedef sitenin beklediği başlıkları ve kimliği taklit ediyoruz
    const response = await fetch(targetUrl, {
      method: req.method,
      headers: {
        "Host": "trend48.st",
        "Referer": "https://trend48.st/live-tv?ch=beinsports1-tr",
        "Origin": "https://trend48.st",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
        "Accept-Language": "tr-TR,tr;q=0.9,en-US;q=0.8,en;q=0.9"
      },
    });

    // Hedef siteden gelen verinin içeriğini (HTML, Stream vb.) alıyoruz
    const contentType = response.headers.get("content-type") || "text/html";
    res.setHeader("Content-Type", contentType);
    
    // CORS engeline takılmamak için başlıkları serbest bırakıyoruz
    res.setHeader("Access-Control-Allow-Origin", "*");
    res.setHeader("Access-Control-Allow-Methods", "GET, OPTIONS");
    res.setHeader("Access-Control-Allow-Headers", "*");

    // Gelen veriyi okuyup istemciye (tarayıcıya) yansıtıyoruz
    const data = await response.arrayBuffer();
    return res.status(response.status).send(Buffer.from(data));

  } catch (error) {
    return res.status(500).json({ error: "Proxy Hata: " + error.message });
  }
}
