// 1. Önce ayarları tanımlıyorsun
var hlsConfig = {
  liveSyncDurationCount: 15, // Canlı yayını geriden takip etme payı
  maxBufferLength: 60,       // Tamponda tutulacak maksimum süre
};

// 2. Hls nesnesini bu ayarla birlikte oluşturuyorsun
if (Hls.isSupported()) {
  var video = document.getElementById('video');
  var hls = new Hls(hlsConfig); // <-- Ayarı buraya veriyorsun!
  
  hls.loadSource('senin_yayin_linkin.m3u8');
  hls.attachMedia(video);
  hls.on(Hls.Events.MANIFEST_PARSED, function() {
    video.play();
  });
}
